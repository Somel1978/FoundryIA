# Copy to .env (repo root) or apps/web/.env.local, or set real environment
# variables. Precedence: real env vars > apps/web/.env* > repo-root .env*.
# Restart the server after changing any of these.

# Admin password — set ONE of these (at least 12 characters in production).
#
# Recommended: a hash, generated with `pnpm hash-password`. Safe for any
# characters and keeps the password itself out of config files.
# ADMIN_PASSWORD_HASH=scrypt:...
#
# Or the password itself. Careful in apps/web/.env*: Next.js expands `$VAR`
# there even inside quotes, so write `\$` for a literal dollar sign.
# (The repo-root .env is read literally, no expansion.)
ADMIN_PASSWORD=change-me-to-something-long

# Secret used to sign the admin session cookie. Required; at least 32 characters.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Port the server listens on (all interfaces, 0.0.0.0). Point your
# Cloudflare Tunnel ingress at http://<this-host>:<PORT>.
PORT=3000

# Where the SQLite DB, code snapshots and release files live.
# Defaults to <monorepo root>/data
# DATA_DIR=/var/lib/foundry

# Max upload size in MB. Cloudflare rejects request bodies over 100 MB on
# Free/Pro plans (200 MB Business, 500 MB Enterprise).
# MAX_UPLOAD_MB=100

# Extra public hostnames allowed to submit forms, comma-separated. Only needed
# if your tunnel rewrites the Host header (e.g. httpHostHeader is set).
# ALLOWED_ORIGINS=code.example.com

# The admin cookie is marked Secure automatically when the browser uses HTTPS
# (e.g. through Cloudflare) and not on plain http://<lan-ip>. Force with
# true/false if needed.
# COOKIE_SECURE=true

# Copy to apps/web/.env.local (or provide as real environment variables).

# Password for the /admin area. Required; at least 12 characters in production.
ADMIN_PASSWORD=change-me-to-something-long

# Secret used to sign the admin session cookie. Required; at least 32 characters.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Port the server listens on (all interfaces, 0.0.0.0). Point your
# Cloudflare Tunnel ingress at http://<this-host>:<PORT>.
PORT=3000

# Where the SQLite DB, code snapshots and release files live.
# Defaults to <monorepo root>/data
# DATA_DIR=/var/lib/foundry

# Max upload size in MB. Cloudflare rejects request bodies over 100 MB on
# Free/Pro plans (200 MB Business, 500 MB Enterprise).
# MAX_UPLOAD_MB=100

# Extra public hostnames allowed to submit forms, comma-separated. Only needed
# if your tunnel rewrites the Host header (e.g. httpHostHeader is set).
# ALLOWED_ORIGINS=code.example.com

# The admin cookie is HTTPS-only in production. Set to false only if you need
# to sign in over plain HTTP (e.g. http://192.168.x.x:3000 on your LAN).
# COOKIE_SECURE=false
